---
// Replaces Starlight's hero on splash pages (the landing page only).
import { Code } from '@astrojs/starlight/components';

import CopyCommand from './CopyCommand.astro';

const hero = Astro.locals.starlightRoute.entry.data.hero;

const code = `val ship = SpriteVisual.Triangle(Color(1f, 1f, 1f))

object Arena extends Scene {
  override def load(ctx: GameContext)(using Scope): Unit = {
    ctx.spawn2D("Camera")
      .attach(new Camera2D(_, Vec2(800f, 600f)))

    ctx.spawn2D("Ship")
      .attach(new Collider(_, radius = 14f))
      .attach(new Ship(_)) // needs Spatial2D & Collider
      .attach(new SpriteRenderer(_, ship, 28f, 34f))
  }
}`;
---

<section class="sgl-hero not-content">
  <div>
    <p class="section-eyebrow">Scala 3 · Bazel · Open Source</p>
    <h1>
      Code-first games.<br />
      <span class="gradient-text">Verified by the compiler.</span>
    </h1>
    <p class="tagline">{hero?.tagline}</p>
    <div class="hero-actions">
      <a class="sgl-button primary" href="/docs/getting-started/">Build your first game →</a>
      <a class="sgl-button secondary" href="/docs/">Read the docs</a>
    </div>
    <CopyCommand
      label="Ask your coding agent"
      link={{ label: 'How it works →', href: '/docs/ai-agents/' }}
      command="Make a game with SGL: follow https://libsgl.com/start.md"
    >
      Make a game with SGL: follow <a href="/start.md">https://libsgl.com/start.md</a>
    </CopyCommand>
  </div>
  <div class="hero-code">
    <Code code={code} lang="scala" title="Arena.scala" />
    <div class="hero-targets">
      <span>Desktop JVM</span>
      <span>Web (Scala.js)</span>
      <span>Scala Native</span>
      <span>Android</span>
      <span>Headless OpenGL</span>
    </div>
  </div>
</section>
