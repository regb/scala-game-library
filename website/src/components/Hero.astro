---
// Replaces Starlight's hero on splash pages (the landing page only).
import { Code } from '@astrojs/starlight/components';

const hero = Astro.locals.starlightRoute.entry.data.hero;

const code = `trait AbstractApp extends Application {
  this: CanvasProvider with WindowProvider =>

  import Graphics.Color
  private var x = 0f
  private def paint(c: Color) = Graphics.defaultPaint.withColor(c)

  override def frame(dt: Double): Unit = {
    if(Input.isKeyPressed(Input.Keys.Right))
      x += 240f * dt.toFloat

    withFrameCanvas { canvas =>
      val (w, h) = (Window.width.toFloat, Window.height.toFloat)
      canvas.drawRect(0, 0, w, h, paint(Color.Black))
      canvas.drawCircle(x, h / 2, 24f, paint(Color.Red))
    }
  }
}`;
---

<section class="sgl-hero not-content">
  <div>
    <a class="hero-pill" href="/docs/">
      <strong>Pre-release</strong> Scala 3 · Bazel · open source
    </a>
    <h1>
      Write your game once.<br />
      <span class="gradient-text">Ship it everywhere.</span>
    </h1>
    <p class="tagline">{hero?.tagline}</p>
    <div class="hero-actions">
      <a class="sgl-button primary" href="/docs/getting-started/">Build your first game →</a>
      <a class="sgl-button secondary" href="/docs/">Read the docs</a>
    </div>
    <div class="hero-command"><span>$</span> bazel run //examples/hello-canvas:desktop-awt</div>
  </div>
  <div class="hero-code">
    <Code code={code} lang="scala" title="App.scala" />
    <div class="hero-targets">
      <span>Desktop JVM</span>
      <span>Web (Scala.js)</span>
      <span>Scala Native</span>
      <span>Android</span>
    </div>
  </div>
</section>
