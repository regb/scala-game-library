---
// Replaces Starlight's hero on splash pages (the landing page only).
import { Code } from '@astrojs/starlight/components';

const hero = Astro.locals.starlightRoute.entry.data.hero;

const code = `trait AbstractApp extends OpenGLGameObjectApp {
  override def configure(builder: GameBuilder): Unit =
    builder
      .install(UpdateCapabilitiesModule)
      .install(Render2DModule)
      .setInitialScene(Arena)
}

final class Ship(obj: TypedObject[Spatial2D & Collider])
    extends ComponentOf(obj) with Updatable {
  private val spatial = obj.spatial
  private val collider = obj.get[Collider] // guaranteed at compile time

  override def update(context: GameContext)(using Scope): Unit =
    if(Input.isKeyPressed(Input.Keys.Right))
      spatial.local = spatial.local.copy(
        position = spatial.local.position + Vec2(240f * context.dt, 0f)
      )
}

object Arena extends Scene {
  override def load(context: GameContext)(using Scope): Unit = {
    context.spawn2D("Camera").attach(new Camera2D(_, Vec2(800f, 600f)))
    context.spawn2D("Ship")
      .attach(new Collider(_, 14f)) // omitting this fails to compile
      .attach(new Ship(_))
      .attach(new SpriteRenderer(_, SpriteVisual.Triangle(Color(1f, 1f, 1f)), 28f, 34f))
  }
}`;
---

<section class="sgl-hero not-content">
  <div>
    <a class="hero-pill" href="/docs/ai-agents/">
      <strong>Agent-ready</strong> Code-first · Declarative · Compiler-verified →
    </a>
    <h1>
      Code-first games.<br />
      <span class="gradient-text">Verified by the compiler.</span>
    </h1>
    <p class="tagline">{hero?.tagline}</p>
    <div class="hero-actions">
      <a class="sgl-button primary" href="/docs/getting-started/">Build your first game →</a>
      <a class="sgl-button secondary" href="/docs/ai-agents/">AI agents & verification</a>
      <a class="sgl-button secondary" href="/docs/">Read the docs</a>
    </div>
    <div class="hero-command"><span>$</span> bazel run //engines/gameobject/examples/asteroids:desktop-lwjgl</div>
  </div>
  <div class="hero-code">
    <Code code={code} lang="scala" title="App.scala" />
    <div class="hero-targets">
      <span>Desktop JVM</span>
      <span>Web (Scala.js)</span>
      <span>Scala Native</span>
      <span>Android</span>
      <span>Headless OpenGL</span>
    </div>
  </div>
</section>
