---
import { Code, Icon, TabItem, Tabs } from '@astrojs/starlight/components';

import ShowcaseCard from './ShowcaseCard.astro';
import { games, repo, studio } from '../data/showcase';

const platforms = [
  { icon: 'laptop', name: 'Desktop JVM', body: 'AWT for Canvas games, LWJGL for OpenGL 3.3 and OpenAL.', status: 'Supported' },
  { icon: 'window', name: 'Web', body: 'Scala.js with 2D Canvas or WebGL 2, deployable static sites, and HTML5 audio.', status: 'Supported' },
  { icon: 'linux', name: 'Native', body: 'Scala Native on SDL2 and OpenGL ES. Native executables with no JVM.', status: 'Supported' },
  { icon: 'mobile-android', name: 'Android', body: 'Kotlin host library; Bazel generates the Gradle project, APK, and Play bundle.', status: 'Supported' },
  { icon: 'setting', name: 'Headless OpenGL', body: 'Mesa surfaceless EGL pbuffer for CI tests, synthetic input, and frame capture.', status: 'Supported' },
  { icon: 'apple', name: 'iOS', body: 'No native backend yet. Web builds can be packaged as apps with Cordova.', status: 'Via Cordova', experimental: true },
] as const;

const verificationSteps = [
  {
    step: '01',
    title: 'Machine-readable context',
    body: 'One prompt points an agent at /start.md: a tested project template, its AGENTS.md, the SGL Agent Skill, and /llms.txt.',
  },
  {
    step: '02',
    title: 'Declarative, concise code',
    body: 'Assets in BUILD, typed attach chains, and plain-text scenes—zero opaque binary files or inspector state.',
  },
  {
    step: '03',
    title: 'Compiler guardrails',
    body: 'Missing providers, broken asset names, duplicate components, and leaked scopes fail at compile time with exact fixes.',
  },
  {
    step: '04',
    title: 'Headless frame verification',
    body: 'Drive inputs with Controller, step deterministically on HeadlessOpenGLApp, and assert on pixels or inspect captured PNGs.',
  },
] as const;

const features = [
  {
    icon: 'approve-check',
    title: 'Compile-time checked composition',
    body: 'TypedObject tracks attached components in the object’s type. Attaching a component before its dependency, or attaching duplicates, fails to compile.',
    href: '/docs/gameobject/',
  },
  {
    icon: 'document',
    title: 'Typed, declarative assets',
    body: 'Declare images, atlases, audio, fonts, and Tiled maps in Bazel. Code references Assets.drawable.player—broken paths and typos never reach runtime.',
    href: '/docs/assets/',
  },
  {
    icon: 'setting',
    title: 'Deterministic headless testing',
    body: 'Run real OpenGL headlessly with no display or GPU, inject synthetic input, step fixed frames, and capture RGBA8 screenshots in bazel test.',
    href: '/docs/testing/',
  },
  {
    icon: 'rocket',
    title: 'Built for AI coding agents',
    body: 'Plain-text everything, strict compiler feedback, /llms.txt endpoints, and an official skills/sgl Agent Skill close the generate-compile-verify loop.',
    href: '/docs/ai-agents/',
  },
  {
    icon: 'puzzle',
    title: 'Concise, layered architecture',
    body: 'Every game starts from portable Canvas or OpenGL providers wired via self-types. Add the GameObject or Screen2D engine only when you need one.',
    href: '/docs/core-concepts/',
  },
  {
    icon: 'seti:scala',
    title: 'Fast iteration, one-command targets',
    body: 'Hot reload sprites, levels, and live tuning values without recompiling Scala, then build Desktop, Web, Native, and Android from one BUILD file.',
    href: '/docs/hot-reload/',
  },
] as const;

const canvasCode = `trait AbstractApp extends Application with AssetsProvider {
  this: CanvasProvider with WindowProvider with SystemProvider =>

  private lazy val player = Graphics.loadImage(Assets.drawable.player)

  override def frame(dt: Double): Unit = withFrameCanvas { canvas =>
    if(player.isLoaded) canvas.drawBitmap(player.value.get.get, 32f, 32f)
  }
}`;

const gameObjectCode = `trait AbstractApp extends OpenGLGameObjectApp {
  override def configure(builder: GameBuilder): Unit =
    builder
      .install(UpdateCapabilitiesModule)
      .install(Render2DModule)
      .setInitialScene(Level)
}

final class Spin(obj: GameObject2D) extends ComponentOf(obj) with Updatable {
  private val spatial = obj.spatial

  override def update(context: GameContext)(using Scope): Unit = {
    spatial.local = spatial.local.copy(rotation = spatial.local.rotation + 2f * context.dt)
  }
}

object Level extends Scene {
  override def load(context: GameContext)(using Scope): Unit = {
    context.spawn2D("Camera").attach(new Camera2D(_, Vec2(800f, 600f)))
    context.spawn2D("Ship")
      .attach(new Spin(_))
      .attach(new SpriteRenderer(_, SpriteVisual.Triangle(Color(1f, 1f, 1f)), 28f, 34f))
  }
}`;

const screen2dCode = `trait AbstractApp {
  this: Screen2DGameApp =>

  override def startingScreen: GameScreen = new TitleScreen

  class TitleScreen extends GameScreen {
    override def name: String = "title"
    override def update(dt: Long): Unit = ()  // milliseconds
    override def render(canvas: Graphics.Canvas): Unit =
      canvas.drawRect(0, 0, Window.width.toFloat, Window.height.toFloat,
        Graphics.defaultPaint.withColor(Graphics.Color.Blue))
  }
}`;

const quickstartCode = `git clone https://github.com/regb/scala-game-library.git
cd scala-game-library

# Desktop (OpenGL)
bazel run //engines/gameobject/examples/asteroids:desktop-lwjgl

# Web: serves the Scala.js build on http://localhost:8080
bazel run //engines/gameobject/examples/asteroids:html5

# Verify rendering & input headlessly (no display required)
bazel test //engines/gameobject/examples/headless-control:headless-control-integration-test`;
---

<div class="not-content">
  <section class="landing-section">
    <p class="section-eyebrow">Built for Reliability &amp; AI Agents</p>
    <h2 class="section-title">A closed verification loop for code-first games.</h2>
    <p class="section-lead">
      No opaque binary scenes, no stringly-typed asset lookups, and no runtime guesswork. SGL pairs
      concise declarative code with Scala 3 compiler guardrails and headless OpenGL frame capture so
      every change—human-written or AI-generated—is verified from the terminal.
    </p>
    <div class="loop-grid">
      {verificationSteps.map((item) => (
        <div class="loop-step">
          <span class="loop-num">{item.step}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </div>
      ))}
    </div>
    <div class="hero-actions section-more">
      <a class="sgl-button primary" href="/docs/ai-agents/">Explore the verification loop →</a>
      <a class="sgl-button secondary" href={`${repo}/blob/master/skills/sgl/SKILL.md`}>SGL Agent Skill</a>
      <a class="sgl-button secondary" href="https://github.com/regb/sgl-starter-project">Project template</a>
    </div>
  </section>

  <section class="landing-section">
    <p class="section-eyebrow">Why SGL</p>
    <h2 class="section-title">Code-first. Declarative. Compiler-verified.</h2>
    <p class="section-lead">
      SGL puts the type system, build graph, and test runner to work for game reliability—keeping
      game code concise, diffable, and free of hidden editor state.
    </p>
    <div class="feature-grid">
      {features.map((f) => (
        <article class="feature">
          <span class="feature-icon"><Icon name={f.icon} size="1.25rem" /></span>
          <h3>{f.title}</h3>
          <p>{f.body}</p>
          <a href={f.href}>Learn more →</a>
        </article>
      ))}
    </div>
  </section>

  <section class="landing-section layers">
    <div>
      <p class="section-eyebrow">Architecture</p>
      <h2 class="section-title">Start minimal. Opt into an engine when you need one.</h2>
      <p class="section-lead">
        Every game shares the same portable core. Engines are optional, declarative architectures on
        top of it—choose at most one.
      </p>
      <div class="layer-stack">
        <div class="layer-split">
          <div class="layer" style="--layer-color: var(--sgl-brand-2)">
            <h3>GameObject</h3>
            <p>Typed components, systems, scenes. 2D and 3D on OpenGL.</p>
          </div>
          <div class="layer" style="--layer-color: var(--sgl-brand-3)">
            <h3>Screen2D</h3>
            <p>Screen stack and game loop for Canvas games.</p>
          </div>
        </div>
        <div class="layer">
          <h3>Core <code>//core:sgl-core</code></h3>
          <p>Application lifecycle, Canvas, OpenGL, input, audio, typed assets, saves, math.</p>
        </div>
        <div class="layer" style="--layer-color: var(--sl-color-gray-4)">
          <h3>Backends <code>//backends/...</code></h3>
          <p>AWT, LWJGL, HTML5, Scala Native, Android, headless OpenGL.</p>
        </div>
      </div>
    </div>
    <div>
      <Tabs syncKey="landing-layer">
        <TabItem label="GameObject">
          <Code code={gameObjectCode} lang="scala" title="App.scala" />
        </TabItem>
        <TabItem label="Core Canvas">
          <Code code={canvasCode} lang="scala" title="App.scala" />
        </TabItem>
        <TabItem label="Screen2D">
          <Code code={screen2dCode} lang="scala" title="App.scala" />
        </TabItem>
      </Tabs>
    </div>
  </section>

  <section class="landing-section">
    <p class="section-eyebrow">Showcase</p>
    <h2 class="section-title">Shipped games built with SGL.</h2>
    <p class="section-lead">
      Published games from <a href={studio.href}>{studio.name}</a> (try
      {' '}<a href="https://smartdinogames.com/games/rat-trap/play/">Rat Trap in your browser</a>),
      plus the open-source Scalavator.
    </p>
    <div class="show-grid featured">
      {games.map((entry) => <ShowcaseCard entry={entry} />)}
    </div>
    <div class="hero-actions section-more">
      <a class="sgl-button secondary" href="/showcase/">See the showcase →</a>
    </div>
  </section>

  <section class="landing-section">
    <p class="section-eyebrow">Platforms</p>
    <h2 class="section-title">One codebase. Native on every target.</h2>
    <p class="section-lead">
      Game code depends only on typed provider APIs. Each backend is a declarative Bazel target that
      generates the platform entry point and checks wiring at compile time.
    </p>
    <div class="platform-grid">
      {platforms.map((p) => (
        <div class="platform">
          <Icon name={p.icon} size="1.5rem" />
          <h3>{p.name}</h3>
          <p>{p.body}</p>
          <span class:list={['status', { experimental: 'experimental' in p }]}>{p.status}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="landing-section quickstart">
    <div>
      <p class="section-eyebrow">Quickstart</p>
      <h2 class="section-title">Build, run, and verify in three commands.</h2>
      <ol>
        <li><strong>Install Bazelisk</strong>The repository pins its Bazel version, and Bazel downloads Scala, the JDK, Scala.js, and Scala Native automatically.</li>
        <li><strong>Run on desktop or web</strong>A single <code>bazel run</code> compiles the shared core and launches a native window or a local web build.</li>
        <li><strong>Verify headlessly</strong>Run <code>bazel test</code> to step the game on Mesa headless OpenGL and assert on rendered frames.</li>
      </ol>
      <div class="hero-actions">
        <a class="sgl-button secondary" href="/docs/installation/">Installation guide</a>
        <a class="sgl-button secondary" href="/docs/ai-agents/">Agent setup</a>
      </div>
    </div>
    <Code code={quickstartCode} lang="bash" title="Terminal" />
  </section>

  <section class="landing-section">
    <p class="section-eyebrow">Project</p>
    <h2 class="section-title">Follow along.</h2>
    <div class="callout-grid">
      <article class="callout">
        <span class="callout-icon"><Icon name="rocket" /></span>
        <h3>What's new</h3>
        <ul>
          <li>New <a href="/docs/ai-agents/">AI coding agents guide</a>, <a href={`${repo}/blob/master/skills/sgl/SKILL.md`}>SGL Agent Skill</a>, and <a href="/llms.txt"><code>llms.txt</code></a> endpoints.</li>
          <li>Asset and settings <a href="/docs/hot-reload/">hot reload</a> on desktop and HTML5 with zero release overhead.</li>
          <li>Compile-time checked <a href="/docs/gameobject/#composition-checked-by-the-compiler"><code>TypedObject</code> composition</a> and build-time <a href="/docs/assets/#texture-atlases">texture atlases</a>.</li>
          <li>A <a href="/docs/testing/">headless OpenGL backend</a> to step games and capture frames without a window.</li>
        </ul>
        <div class="hero-actions">
          <a class="sgl-button secondary" href="/docs/migration/">Migration notes</a>
          <a class="sgl-button secondary" href={`${repo}/commits/master`}>All changes</a>
        </div>
      </article>
      <article class="callout">
        <span class="callout-icon"><Icon name="github" /></span>
        <h3>Community</h3>
        <p>
          SGL is developed in the open on GitHub. Ask questions and report bugs in the issues, send
          pull requests, and share what you build: games made with SGL are added to the showcase.
        </p>
        <div class="hero-actions">
          <a class="sgl-button secondary" href="/community/">Get involved</a>
          <a class="sgl-button secondary" href={`${repo}/issues`}>Issues</a>
        </div>
      </article>
    </div>
  </section>

  <section class="landing-section cta">
    <h2 class="section-title">Build something verified.</h2>
    <p class="section-lead">
      SGL is pre-0.1 and evolves quickly—expect breaking changes as the API matures. Issues,
      feedback, and games built with SGL are always welcome.
    </p>
    <div class="hero-actions">
      <a class="sgl-button primary" href="/docs/getting-started/">Get started</a>
      <a class="sgl-button secondary" href="/docs/ai-agents/">Use with AI agents</a>
      <a class="sgl-button secondary" href={repo}>Star on GitHub</a>
    </div>
  </section>
</div>
